<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html, body {
        height: 100%;
      }

      body {
        font-family: Arial, sans-serif;
        font-size: 11pt;
        color: #000;
        margin: 0;
        padding: 0;
      }

      .wrapper {
        position: relative;
        width: 100%;
        min-height: 100%;
        overflow: hidden;
      }

      @page {
        margin: 0;
      }

      .bg-img {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        z-index: -1;
        pointer-events: none; /* optional - supaya klik tak terganggu */
      }

      .content {
        position: relative;
        padding: 40px;
        color: black; /* warna sesuai jika background gelap */
      }

      .section {
        margin-bottom: 12px;
      }

      .label {
        display: inline-block;
        width: 100px;
        font-weight: bold;
      }

      .value {
        display: inline-block;
      }

      .objectives {
        margin-top: 5px;
        white-space: pre-wrap;
      }

      .image-row {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
        margin-bottom: 10px;
      }

      .image-container {
        width: 48%;
        text-align: center;
        font-size: 10pt;
      }

      .image-container img {
        width: 100%;
        height: auto;
        max-height: 180px;
        object-fit: cover;
        border: 1px solid #ccc !important;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      td {
        border: 1px solid #000 !important;
        padding: 5px;
      }

      .signature-section {
        margin-top: 40px;
        display: flex;
        justify-content: space-between;
        font-size: 11pt;
      }

      .signature-block {
        width: 30%;
        text-align: left;
      }

      .signature-line {
        margin-top: 40px;
        border-top: 1px solid #000;
        width: 100%;
      }

      .school {
        font-size: 10pt;
        color: #444;
        margin-top: 5px;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <img src="data:image/jpeg;base64," class="bg-img" alt="Background Image">
      <div class="content">
                <div style="text-align: center; margin-bottom: 20px;">
          <img src="https://lh3.googleusercontent.com/d/15BJ119qQWyBepLyaVjP4IOk-EbIgovP-=w1920" alt="Header Banner" style="width: 100%; height: auto; max-height: 120px; object-fit: contain;">
        </div>

        <div class="section"><span class="label">Program:</span> <span class="value"><%= formData.programName %></span></div>
        <div class="section"><span class="label">Anjuran:</span> <span class="value"><%= formData.organizer %></span></div>
        <div class="section"><span class="label">Tarikh:</span> <span class="value"><%= formData.date %></span></div>
        <div class="section"><span class="label">Tempat:</span> <span class="value"><%= formData.location %></span></div>
        <div class="section"><span class="label">Sasaran:</span> <span class="value"><%= formData.targetAudience %></span></div>

        <div class="section">
          <div class="label">Objektif:</div>
          <div class="objectives"><%= formData.objectives %></div>
        </div>

        <div class="image-row">
          <% if (imagesData[0]) { %>
            <div class="image-container">
              <img src="data:image/jpeg;base64,<%= imagesData[0].data %>" alt="Gambar 1" style="width:270px;">
              <div><%= imagesData[0].description %></div>
            </div>
          <% } %>
          <% if (imagesData[1]) { %>
            <div class="image-container">
              <img src="data:image/jpeg;base64,<%= imagesData[1].data %>" alt="Gambar 2" style="width:270px;">
              <div><%= imagesData[1].description %></div>
            </div>
          <% } %>
        </div>

        <div class="image-row">
          <% if (imagesData[2]) { %>
            <div class="image-container">
              <img src="data:image/jpeg;base64,<%= imagesData[2].data %>" alt="Gambar 3" style="width:270px;">
              <div><%= imagesData[2].description %></div>
            </div>
          <% } %>
          <% if (imagesData[3]) { %>
            <div class="image-container">
              <img src="data:image/jpeg;base64,<%= imagesData[3].data %>" alt="Gambar 4" style="width:270px;">
              <div><%= imagesData[3].description %></div>
            </div>
          <% } %>
        </div>

        <div class="signature-section">
          <div class="signature-block">
            <div><strong>Disediakan oleh:</strong></div>
            <div class="signature-line"></div>
            <div><%= formData.userName %></div>
            <div><%= formData.position %></div>
            <div class="school">SK KAMPUNG BAHAGIA JAYA, SIBU</div>
          </div>
          <div class="signature-block">
            <div><strong>Disemak oleh:</strong></div>
            <div class="signature-line"></div>
            <div><%= formData.userName1 %></div>
            <div><%= formData.position1 %></div>
            <div class="school">SK KAMPUNG BAHAGIA JAYA, SIBU</div>
          </div>
          <div class="signature-block">
            <div><strong>Disahkan oleh:</strong></div>
            <div class="signature-line"></div>
            <div><%= formData.userName2 %></div>
            <div><%= formData.position2 %></div>
            <div class="school">SK KAMPUNG BAHAGIA JAYA, SIBU</div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
